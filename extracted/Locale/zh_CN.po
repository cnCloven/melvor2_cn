#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Ashen Lands Trail"
msgstr "灰烬之地小径"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Ashen Tree[/color] in Woodcutting which provide "
"[color=#FFD16D]Ashen Logs[/color] used in various areas of the game."
msgstr ""
"解锁伐木技能中的[color=#FFD16D]灰烬树[/color]。砍伐灰烬树可获得[color=#FFD16D]灰烬原木[/"
"color]，在游戏中有多种用途。"

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Dense Cave Trail"
msgstr "密岩洞窟小径"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Dense Coal Rock[/color] in Mining which is a much more "
"efficient source of [color=#FFD16D]Coal[/color]."
msgstr ""
"解锁采矿技能中的[color=#FFD16D]致密煤岩[/color]。开采这种矿石能更高效地获得"
"[color=#FFD16D]煤炭[/color]。"

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Torag Grounds Trail"
msgstr "托拉格栖息地小径"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Torag Grounds[/color] Location in Hunting, allowing you to "
"hunt [color=#FFD16D]Torag[/color] which drop materials for high-level gear."
msgstr ""
"解锁狩猎地点[color=#FFD16D]托拉格栖息地[/color]。在这里猎杀[color=#FFD16D]托拉格[/"
"color]，可获得制作高级装备的材料。"

